<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

        <!--
            The alert changelogs keep the relative path they have in energy-monitor-backend:
            Liquibase identifies a changeset by id, author and file path, so the changesets the
            monolith already applied to the shared schema are recognised here as applied and
            never run twice.
        -->
        <include file="alert/alert-changelog.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>
