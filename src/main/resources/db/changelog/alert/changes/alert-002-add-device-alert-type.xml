<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        DEVICE alerts are informational (e.g. "a module was linked to this home"), so members are
        told about changes to the home's devices through the same inbox, mail and push channels.
    -->
    <changeSet id="alert-002-add-device-alert-type" author="JuanCortes2045">
        <comment>alert.type accepts DEVICE.</comment>
        <sql dbms="mysql">ALTER TABLE alert MODIFY type ENUM('THRESHOLD', 'CONNECTIVITY', 'DEVICE') NOT NULL</sql>

        <rollback>
            <sql dbms="mysql">DELETE FROM alert WHERE type = 'DEVICE'</sql>
            <sql dbms="mysql">ALTER TABLE alert MODIFY type ENUM('THRESHOLD', 'CONNECTIVITY') NOT NULL</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
