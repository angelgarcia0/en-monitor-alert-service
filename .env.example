# Copy this file to .env and replace every CHANGE_ME. It is in .gitignore: never commit it.
#
# Spring reads it in .properties format, so write values without quotes and without $:
# a value containing $ is treated as a placeholder and the application fails to start.

# Database. MySQL runs from the infra repository, which creates the energy_app user with
# MYSQL_PASSWORD of infra/.env. Put that same password here: the tests need it, because the
# "test" profile does not load application-local.yaml.
SPRING_DATASOURCE_PASSWORD=

# HTTP port. 8080 is the API gateway, 8082 the security service, 8083 energy-monitor-backend,
# 8084 the device service, 8085 the measurement service, 8086 the home service and 8087 the
# notification service on the same machine.
# SERVER_PORT=8088

# Public key of the security service, to validate the access tokens. Absolute path.
SECURITY_JWT_PUBLIC_KEY_PATH=/home/CHANGE_ME/.energy-monitor/keys/public.pem

# Calls to the other services. The same INTERNAL_API_TOKEN as in infra/.env and every service:
# empty, they refuse every call.
INTERNAL_API_TOKEN=CHANGE_ME
# Who may read the alerts of a home, and its consumption limits.
HOME_SERVICE_URL=http://localhost:8086
# The home of a device, when it was linked and the devices of a home.
DEVICE_SERVICE_URL=http://localhost:8084
# The consumption levels and the energy of the devices.
MEASUREMENT_SERVICE_URL=http://localhost:8085

# Zone in which the day and the month of the consumption limit start.
# ALERT_LIMIT_ZONE=America/Bogota

# Message broker (RabbitMQ from infra): RABBITMQ_USERNAME/RABBITMQ_PASSWORD of infra/.env.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=energy-monitor
RABBITMQ_PASSWORD=CHANGE_ME

# Whether this service raises the alerts. Off until energy-monitor-backend no longer raises them:
# with both on, every alert would be raised twice. Its queues fill up meanwhile.
# ALERT_CONSUMERS_ENABLED=false
